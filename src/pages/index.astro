---
// PRIVATE BETA GATE.
// The full marketing landing page (live demo, features, pricing, Stripe links)
// is preserved in git history. To bring it back:
//   git log --oneline -- src/pages/index.astro
//   git checkout <commit-before-the-gate> -- src/pages/index.astro
// The API side of the gate lives in app/core/config.py (PUBLIC_* flags).
import Layout from '../layouts/Layout.astro';
---

<Layout title="CyberAPI | Private Beta" description="CyberAPI is a threat intelligence API, currently in private beta. Request access.">
	<main class="min-h-screen flex flex-col">
		<div class="flex-1 flex items-center justify-center px-4 py-20">
			<div class="w-full max-w-lg">
				<div class="flex items-center gap-3 mb-12">
					<img src="/logo.png" alt="CyberAPI" class="w-9 h-9 rounded-lg" />
					<span class="font-bold text-xl tracking-tight text-white">CyberAPI</span>
				</div>

				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-950/30 border border-amber-500/30 text-amber-300 text-xs font-bold mb-8 uppercase tracking-wider">
					<span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
					<span>Private Beta</span>
				</div>

				<h1 class="text-3xl sm:text-4xl font-bold text-white mb-6 leading-tight">
					Threat intelligence, currently behind closed doors.
				</h1>

				<p class="text-slate-400 leading-relaxed mb-4">
					CyberAPI scores domains and IP addresses in real time — blacklists, DNS and
					SSL posture, domain age, look-alike detection, brand impersonation.
				</p>
				<p class="text-slate-400 leading-relaxed mb-10">
					We have closed public signups while we take the service to where it needs to
					be. Existing customers are unaffected. Leave your address and we will write
					to you when access opens.
				</p>

				<form id="waitlist-form" class="space-y-3">
					<label for="waitlist-email" class="sr-only">Email address</label>
					<input
						type="email"
						id="waitlist-email"
						required
						autocomplete="email"
						placeholder="you@company.com"
						class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-cyan-500/50 focus:ring-1 focus:ring-cyan-500/50 transition-all"
					/>
					<button
						type="submit"
						id="waitlist-btn"
						class="w-full py-3 px-6 rounded-lg bg-gradient-to-r from-cyan-600 to-purple-600 hover:from-cyan-500 hover:to-purple-500 text-white font-bold transition-colors"
					>Request access</button>
				</form>

				<div id="waitlist-success" class="hidden mt-6 p-4 rounded-lg bg-cyan-950/30 border border-cyan-500/30">
					<p class="text-cyan-200 text-sm font-medium mb-1">You are on the list.</p>
					<p class="text-slate-400 text-sm">We will email you when access opens. No newsletter, no other use of your address.</p>
				</div>
				<p id="waitlist-error" class="hidden mt-4 text-sm text-red-400"></p>

				<p class="text-slate-500 text-sm mt-10">
					Existing customer, or want to talk about a specific use case?
					Write to <a href="mailto:inbox@cyberapi.io" class="text-cyan-400 hover:underline">inbox@cyberapi.io</a>.
				</p>
			</div>
		</div>

		<footer class="border-t border-white/5 py-6">
			<div class="max-w-lg mx-auto px-4 flex justify-between items-center text-slate-500 text-sm">
				<span>&copy; 2026 CyberAPI</span>
				<div class="flex gap-6">
					<a href="/privacy" class="hover:text-white transition-colors">Privacy</a>
					<a href="/terms" class="hover:text-white transition-colors">Terms</a>
				</div>
			</div>
		</footer>
	</main>
</Layout>

<script>
	const form = document.getElementById('waitlist-form') as HTMLFormElement;
	const email = document.getElementById('waitlist-email') as HTMLInputElement;
	const btn = document.getElementById('waitlist-btn');
	const success = document.getElementById('waitlist-success');
	const error = document.getElementById('waitlist-error');

	if (form && email && btn && success && error) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();

			error.classList.add('hidden');
			btn.setAttribute('disabled', 'true');
			btn.textContent = 'Sending...';

			try {
				const res = await fetch('https://threats.cyberapi.io/api/v1/keys/free', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ email: email.value })
				});
				const data = await res.json();

				if (res.ok) {
					form.classList.add('hidden');
					success.classList.remove('hidden');
					return;
				}

				// FastAPI validation errors arrive as a list under `detail`.
				error.textContent = Array.isArray(data.detail)
					? 'Please enter a valid email address.'
					: (data.detail || 'Something went wrong. Please try again.');
				error.classList.remove('hidden');
			} catch (err) {
				error.textContent = 'Could not reach the server. Please try again in a moment.';
				error.classList.remove('hidden');
			}

			btn.removeAttribute('disabled');
			btn.textContent = 'Request access';
		});
	}
</script>
